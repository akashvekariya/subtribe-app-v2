# Environment Configuration Example
# Copy this to .env.development for local development

# Backend API Configuration (REQUIRED)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public site URL used for canonical links and the sitemap (optional)
# Defaults to https://thesubtribe.com
NEXT_PUBLIC_BASE_URL=http://localhost:3001

# Set to true to silence the client and server logger (optional)
DISABLE_LOGGING=false

# Note: API uses serverless (Cloud Run) - initial request may have cold start delay
